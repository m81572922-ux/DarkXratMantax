<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- HEADER -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            android:tint="@color/accent_cyan"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="DARK XRAT MANTAX"
            android:textColor="@color/accent_cyan"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="@font/orbitron"
            android:layout_marginStart="12dp"/>

        <TextView
            android:id="@+id/tvOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 1 Online"
            android:textColor="@color/success"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- SCROLL CONTENT -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_above="@id/bottomNav"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BANNER ATAS -->
            <ImageView
                android:id="@+id/ivBanner"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@drawable/banner_main"
                android:scaleType="centerCrop"/>

            <!-- KALENDER + ADZAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <!-- KALENDER -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_glass"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:id="@+id/tvTanggal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01"
                        android:textColor="@color/accent_cyan"
                        android:textSize="32sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron"/>

                    <TextView
                        android:id="@+id/tvBulan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Oktober 2026"
                        android:textColor="@color/text_white"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvHari"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kamis"
                        android:textColor="@color/text_gray"
                        android:textSize="11sp"/>
                </LinearLayout>

                <!-- JADWAL ADZAN -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_glass"
                    android:padding="16dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="JADWAL ADZAN"
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron"/>

                    <TextView
                        android:id="@+id/tvSubuh"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Subuh   04:30"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:layout_marginTop="6dp"/>

                    <TextView
                        android:id="@+id/tvDzuhur"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dzuhur  12:00"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvAshar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ashar   15:15"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvMaghrib"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Maghrib 18:00"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvIsya"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Isya    19:15"
                        android:textColor="@color/text_white"
                        android:textSize="11sp"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- CARD PROFIL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card_glass"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@mipmap/ic_launcher"
                    android:background="@drawable/bg_border_glow"
                    android:padding="8dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MANZZ"
                        android:textColor="@color/text_white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron"/>

                    <TextView
                        android:id="@+id/tvRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MANZXRAT"
                        android:textColor="@color/accent_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/rajdhani"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvExpired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PERMANEN"
                    android:textColor="@color/warning"
                    android:textSize="11sp"/>
            </LinearLayout>

            <!-- QUICK ACTIONS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK ACTIONS"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/orbitron"
                android:layout_marginTop="20dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:id="@+id/btnBug"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_glass"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_compass"
                        android:tint="@color/danger"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BUG"
                        android:textColor="@color/text_white"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnSender"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_card_glass"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@android:drawable/ic_menu_send"
                        android:tint="@color/accent_cyan"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SENDER"
                        android:textColor="@color/text_white"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron"
                        android:layout_marginTop="6dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- LATEST UPDATES -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LATEST UPDATES"
                android:textColor="@color/accent_cyan"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="@font/orbitron"
                android:layout_marginTop="24dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DARK XRAT MANTAX v1.0"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:fontFamily="@font/orbitron"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rilis pertama • Fitur lengkap"
                    android:textColor="@color/text_gray"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BOTTOM NAV -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="@drawable/bg_card_glass"
        android:gravity="center"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="HOME"
            android:textColor="@color/accent_cyan"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="@font/orbitron"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navBug"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="BUG"
            android:textColor="@color/text_gray"
            android:textSize="10sp"
            android:fontFamily="@font/orbitron"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navTools"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="TOOLS"
            android:textColor="@color/text_gray"
            android:textSize="10sp"
            android:fontFamily="@font/orbitron"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navSadap"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="SADAP"
            android:textColor="@color/text_gray"
            android:textSize="10sp"
            android:fontFamily="@font/orbitron"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navChat"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="CHAT"
            android:textColor="@color/text_gray"
            android:textSize="10sp"
            android:fontFamily="@font/orbitron"
            android:gravity="center"/>

        <TextView
            android:id="@+id/navProfil"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="PROFIL"
            android:textColor="@color/text_gray"
            android:textSize="10sp"
            android:fontFamily="@font/orbitron"
            android:gravity="center"/>
    </LinearLayout>
</RelativeLayout>