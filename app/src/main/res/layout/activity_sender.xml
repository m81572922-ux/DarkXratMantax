<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/accent_cyan"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="SENDER PANEL"
            android:textColor="@color/accent_cyan"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/orbitron"
            android:layout_marginStart="12dp"/>

        <TextView
            android:id="@+id/tvOnlineCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● 1 Online"
            android:textColor="@color/success"
            android:textSize="11sp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- DAFTAR SENDER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAFTAR SENDER"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/orbitron"/>

            <!-- SENDER PRIVATE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="PRIVATE"
                        android:textColor="@color/text_white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron"/>

                    <TextView
                        android:id="@+id/tvPrivateStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Kosong"
                        android:textColor="@color/danger"
                        android:textSize="11sp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnDaftarPrivate"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="DAFTAR SENDER PRIVATE"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:background="@drawable/bg_button_neon"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>

            <!-- SENDER GLOBAL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="16dp"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="GLOBAL"
                        android:textColor="@color/text_white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/orbitron"/>

                    <TextView
                        android:id="@+id/tvGlobalStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● 1 Aktif"
                        android:textColor="@color/success"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- FORM DAFTAR SENDER -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAFTAR SENDER BARU"
                android:textColor="@color/accent_cyan"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/orbitron"
                android:layout_marginTop="24dp"/>

            <EditText
                android:id="@+id/etNomorSender"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Contoh: 62812xxxxxxxx"
                android:textColorHint="@color/text_dim"
                android:textColor="@color/text_white"
                android:background="@drawable/bg_input_dark"
                android:padding="14dp"
                android:layout_marginTop="8dp"
                android:inputType="phone"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/btnKirimKode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="KIRIM KODE"
                android:textColor="@color/text_white"
                android:textStyle="bold"
                android:background="@drawable/bg_button_neon"
                android:layout_marginTop="12dp"/>

            <LinearLayout
                android:id="@+id/layoutKode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_glass"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KODE VERIFIKASI"
                    android:textColor="@color/accent_cyan"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/orbitron"/>

                <TextView
                    android:id="@+id/tvKode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="------"
                    android:textColor="@color/text_white"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:letterSpacing="0.3"
                    android:layout_marginTop="12dp"/>

                <Button
                    android:id="@+id/btnSalinKode"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="SALIN KODE"
                    android:textColor="@color/text_white"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_neon"
                    android:layout_marginTop="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>